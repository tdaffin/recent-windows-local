{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Type Check Extension",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Compile GSettings Schemas",
      "type": "shell",
      "command": "glib-compile-schemas schemas/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Prepare Extension",
      "dependsOrder": "sequence",
      "dependsOn": ["Type Check Extension", "Compile GSettings Schemas"],
      "problemMatcher": []
    },
    {
      "label": "Build & Enable Extension",
      "type": "shell",
      "command": "gnome-extensions disable recent-windows@local && gnome-extensions enable recent-windows@local && printf '%s\\n' 'If source or metadata changed, log out and back in to load the changes on Wayland.'",
      "dependsOn": "Prepare Extension",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run Extension Tests",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": []
    },
    {
      "label": "GNOME Shell Log Output",
      "type": "shell",
      "command": "journalctl -f -o cat /usr/bin/gnome-shell | grep -i recent-windows",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
